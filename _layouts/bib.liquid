---
---

{% if entry.keywords == 'manuscript' %}

  <div class="publication-entry">
    <div class="publication-row">
      {% if site.enable_publication_thumbnails and entry.preview %}
        <div class="publication-image">{% include publication-preview.html entry=entry %}</div>
      {% else %}
        <div class="publication-image manuscript-placeholder" aria-hidden="true"><i class="fa-regular fa-file-lines"></i></div>
      {% endif %}
      <div class="publication-content">
        {% if entry.manuscript_status %}
          {% assign status_parts = entry.manuscript_status | split: ' · ' %}
          <div class="publication-venue"><span class="publication-venue-primary">{{ status_parts[0] }}</span>{% if status_parts[1] %}<span class="publication-venue-detail">{{ status_parts[1] }}</span>{% endif %}</div>
        {% endif %}
        <div class="title">{{ entry.title }}</div>
        {% if entry.manuscript_detail %}<div class="author">{{ entry.manuscript_detail }}</div>{% endif %}
        {% if entry.manuscript_note %}<div class="author">{{ entry.manuscript_note }}</div>{% endif %}
      </div>
    </div>
  </div>

{% elsif entry.type == 'mastersthesis' %}

  <!-- ================== THESIS LAYOUT ================== -->
  <div class="thesis-entry">
    <div class="title h5 mb-2">{{ entry.title }}</div>
    <div class="periodical">
      <em>{% if entry.school %}{{ entry.school }} M.S. Thesis{% else %}Master's Thesis{% endif %}</em>, {{ entry.year }}.
    </div>
    <div class="links mt-2">
      {% if entry.slides %}<a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm btn-outline-primary" target="_blank">Slides</a>{% endif %}
      {% if entry.pdf %}<a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm btn-outline-primary" target="_blank">PDF</a>{% endif %}
      {% if entry.library %}<a href="{{ entry.library }}" class="btn btn-sm btn-outline-primary" target="_blank">Library</a>{% endif %}
    </div>
  </div>

{% else %}

  <!-- ================== REGULAR PUBLICATION LAYOUT ================== -->
  <div class="publication-entry">
    <div class="publication-row{% unless site.enable_publication_thumbnails and entry.preview %} publication-row-no-image{% endunless %}">
      {% if site.enable_publication_thumbnails and entry.preview %}
        <div class="publication-image">
          {% if entry.project_page %}<a href="{{ entry.project_page | relative_url }}">{% endif %}
            {% include publication-preview.html entry=entry %}
          {% if entry.project_page %}</a>{% endif %}
        </div>
      {% endif %}

      <div id="{{ entry.key }}" class="publication-content {{ entry.key }}">
        {% assign venue_label = entry.series | default: entry.abbr | default: entry.year %}
        {% if venue_label %}
          {% assign venue_parts = venue_label | split: ' ' %}
          {% assign venue_primary = venue_parts | slice: 0, 2 | join: ' ' %}
          {% assign venue_detail = venue_parts | slice: 2, 20 | join: ' ' %}
          <div class="publication-venue">
            <span class="publication-venue-primary">{{ venue_primary }}</span>
            {% if venue_detail != empty %}<span class="publication-venue-detail">{{ venue_detail }}</span>{% endif %}
          </div>
        {% endif %}

        <div class="title">
          {% if entry.project_page %}
            <a href="{{ entry.project_page | relative_url }}">{{ entry.title }}</a>
          {% else %}
            {{ entry.title }}
          {% endif %}
        </div>

        <div class="author">
          {% assign author_array_size = entry.author_array | size %}
          {% assign author_array_limit = author_array_size %}
          {% if site.max_author_limit and author_array_size > site.max_author_limit %}
            {% assign author_array_limit = site.max_author_limit %}
          {% endif %}

          {% for author in entry.author_array limit: author_array_limit %}
            {% assign author_is_self = false %}
            {% assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' %}
            {% assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' %}
            {% if site.scholar.last_name contains author_last_name %}
              {% if site.scholar.first_name contains author.first %}
                {% assign author_is_self = true %}
              {% endif %}
            {% endif %}
            {% assign coauthor_url = null %}
            {% assign clean_last_name = author_last_name | downcase | remove_accents %}
            {% if site.data.coauthors[clean_last_name] %}
              {% for coauthor in site.data.coauthors[clean_last_name] %}
                {% if coauthor.firstname contains author.first %}
                  {% assign coauthor_url = coauthor.url %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}

            <span class="publication-author">
              {%- if author_is_self -%}
                <strong class="author-self">{{ author.first }} {{ author_last_html }}</strong>
              {%- elsif coauthor_url -%}
                <a href="{{ coauthor_url }}">{{ author.first }} {{ author_last_html }}</a>
              {%- else -%}
                {{ author.first }} {{ author_last_html }}
              {%- endif -%}
              {%- unless forloop.last -%}
              {%- if forloop.length > 2 -%}
                  {%- if forloop.rindex == 2 -%},&nbsp;and{%- else -%},{%- endif -%}
                {%- else -%}&nbsp;and{%- endif -%}
              {%- endunless -%}
            </span>
          {%- endfor %}

          {% assign more_authors = author_array_size | minus: author_array_limit %}
          {% if more_authors > 0 %}
            , and
            <span class="more-authors"
              title="click to view {{ more_authors_hide }}"
              onclick="
                this.setAttribute('title', '');
                const more_authors_text = this.innerHTML.trim() === '{{ more_authors_hide }}' ? '{{ more_authors_show }}' : '{{ more_authors_hide }}';
                this.innerHTML = more_authors_text;
              ">
              {{ more_authors_hide }}
            </span>
          {% endif %}
        </div>

        {% if entry.award %}
          {% assign award_html = entry.award | markdownify | remove: '<p>' | remove: '</p>' %}
          {% assign award_html = award_html | replace: '🏆', '<i class="fa-solid fa-trophy award-icon" aria-hidden="true"></i>' %}
          {% assign award_html = award_html | replace: '🏅', '<i class="fa-solid fa-medal award-icon" aria-hidden="true"></i>' %}
          <div class="award-info">{{ award_html }}</div>
        {% endif %}

        <div class="links publication-links">
          {% if entry.abstract %}
            <button
              type="button"
              class="abstract publication-link publication-toggle"
              aria-expanded="false"
              aria-controls="{{ entry.key }}-abstract"
            >
              <span class="publication-toggle-icon" aria-hidden="true">▸</span>
              <span>Abstract</span>
            </button>
          {% endif %}
          {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}" class="publication-link" target="_blank"><i class="fa-solid fa-link publication-link-icon" aria-hidden="true"></i><span>DOI</span></a>{% endif %}
          {% if entry.pdf %}
            {% if entry.pdf contains '://' %}
              <a href="{{ entry.pdf }}" class="publication-link" target="_blank"><i class="fa-solid fa-file-lines publication-link-icon" aria-hidden="true"></i><span>PDF</span></a>
            {% else %}
              <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="publication-link" target="_blank"><i class="fa-solid fa-file-lines publication-link-icon" aria-hidden="true"></i><span>PDF</span></a>
            {% endif %}
          {% endif %}
          {% if entry.video and site.enable_video_embedding %}
            <a class="publication-link video" role="button"><i class="fa-solid fa-play publication-link-icon" aria-hidden="true"></i><span>Video</span></a>
          {% elsif entry.video %}
            <a href="{{ entry.video }}" class="publication-link" target="_blank"><i class="fa-solid fa-play publication-link-icon" aria-hidden="true"></i><span>Video</span></a>
          {% endif %}
          {% if entry.code %}<a href="{{ entry.code }}" class="publication-link" target="_blank"><i class="fa-solid fa-code publication-link-icon" aria-hidden="true"></i><span>Code</span></a>{% endif %}
          {% if entry.project_page %}
            <a href="{{ entry.project_page | relative_url }}" class="publication-link"><i class="fa-solid fa-globe publication-link-icon" aria-hidden="true"></i><span>Page</span></a>
          {% endif %}
          {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="publication-link" target="_blank"><i class="fa-solid fa-file-lines publication-link-icon" aria-hidden="true"></i><span>arXiv</span></a>{% endif %}
          {% if entry.html %}
            {% if entry.html contains '://' %}
              <a href="{{ entry.html }}" class="publication-link" target="_blank"><i class="fa-solid fa-code publication-link-icon" aria-hidden="true"></i><span>HTML</span></a>
            {% else %}
              <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}" class="publication-link" target="_blank"><i class="fa-solid fa-code publication-link-icon" aria-hidden="true"></i><span>HTML</span></a>
            {% endif %}
          {% endif %}
          {% if entry.supp %}
            {% if entry.supp contains '://' %}
              <a href="{{ entry.supp }}" class="publication-link" target="_blank"><i class="fa-solid fa-paperclip publication-link-icon" aria-hidden="true"></i><span>Supp</span></a>
            {% else %}
              <a href="{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}" class="publication-link" target="_blank"><i class="fa-solid fa-paperclip publication-link-icon" aria-hidden="true"></i><span>Supp</span></a>
            {% endif %}
          {% endif %}
          {% if entry.talk %}<a href="{{ entry.talk }}" class="publication-link" target="_blank"><i class="fa-solid fa-video publication-link-icon" aria-hidden="true"></i><span>Talk</span></a>{% endif %}
          {% if entry.poster %}
            {% if entry.poster contains '://' %}
              <a href="{{ entry.poster }}" class="publication-link" target="_blank"><i class="fa-solid fa-images publication-link-icon" aria-hidden="true"></i><span>Poster</span></a>
            {% else %}
              <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}" class="publication-link" target="_blank"><i class="fa-solid fa-images publication-link-icon" aria-hidden="true"></i><span>Poster</span></a>
            {% endif %}
          {% endif %}
          {% if entry.slides %}
            {% if entry.slides contains '://' %}
              <a href="{{ entry.slides }}" class="publication-link" target="_blank"><i class="fa-solid fa-display publication-link-icon" aria-hidden="true"></i><span>Slides</span></a>
            {% else %}
              <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="publication-link" target="_blank"><i class="fa-solid fa-display publication-link-icon" aria-hidden="true"></i><span>Slides</span></a>
            {% endif %}
          {% endif %}
          {% if entry.website %}<a href="{{ entry.website }}" class="publication-link" target="_blank"><i class="fa-solid fa-globe publication-link-icon" aria-hidden="true"></i><span>Website</span></a>{% endif %}
          {% if entry.library %}<a href="{{ entry.library }}" class="publication-link" target="_blank"><i class="fa-solid fa-building-columns publication-link-icon" aria-hidden="true"></i><span>Library</span></a>{% endif %}
          {% if entry.blog %}<a href="{{ entry.blog }}" class="publication-link" target="_blank"><i class="fa-solid fa-rss publication-link-icon" aria-hidden="true"></i><span>Blog</span></a>{% endif %}
          {% if entry.bibtex_show %}<a class="bibtex publication-link" role="button"><i class="fa-solid fa-book-open publication-link-icon" aria-hidden="true"></i><span>Bib</span></a>{% endif %}
        </div>

        {% if entry.abstract %}<div id="{{ entry.key }}-abstract" class="abstract hidden"><p>{{ entry.abstract }}</p></div>{% endif %}
        {% if entry.bibtex_show %}<div class="bibtex hidden"><pre><code>{{ entry.bibtex | hideCustomBibtex }}</code></pre></div>{% endif %}

        {% if entry.video and site.enable_video_embedding %}
          <div class="video hidden">
            <div style="text-align: center;">
              <video controls style="max-width: 100%;">
                <source src="{{ entry.video }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

{% endif %}
